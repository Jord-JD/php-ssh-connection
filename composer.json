{
  "name": "jord-jd/php-ssh-connection",
  "description": "Provides an elegant syntax to connect to SSH servers and execute commands.",
  "type": "library",
  "license": "LGPL-3.0-only",
  "authors": [
    {
      "name": "Jordan Hall",
      "email": "jordan@hall05.co.uk"
    }
  ],
  "require": {
    "php": ">=7.2",
    "phpseclib/phpseclib": "^3.0"
  },
  "require-dev": {
    "phpunit/phpunit": "^7.5 || ^8.5 || ^9.6 || ^10.5 || ^11.5 || ^12.5"
  },
  "autoload": {
    "psr-4": {
      "JordJD\\SSHConnection\\": "src/"
    }
  },
  "replace": {
    "divineomega/php-ssh-connection": "self.version"
  },
  "extra": {
    "branch-alias": {
      "dev-master": "5.0-dev"
    }
  },
  "config": {
    "allow-plugins": {
      "kylekatarnls/update-helper": false
    }
  }
}
